rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isSuperAdmin() {
      return isSignedIn() && userProfile().data.role == 'SUPER_ADMIN';
    }

    function isAdmin() {
      return isSignedIn() && userProfile().data.role in ['SUPER_ADMIN', 'ADMIN'];
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && isAdmin();
      allow update, delete: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
    }

    match /mccCenters/{mccId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn() && isAdmin();
    }

    match /auditLogs/{logId} {
      allow read: if isSignedIn() && isSuperAdmin();
      allow create, update, delete: if isSignedIn() && isSuperAdmin();
    }

    match /{document=**} {
      allow read: if isSignedIn();
      allow write: if false;
    }
  }
}
